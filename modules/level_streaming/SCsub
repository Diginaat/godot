#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_level_streaming = env_modules.Clone()

module_obj = []

env_level_streaming.add_source_files(module_obj, "*.cpp")
if env.editor_build:
    env_level_streaming.add_source_files(module_obj, "editor/*.cpp")

env.modules_sources += module_obj
