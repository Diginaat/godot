; Engine configuration file.
; DDGI test scenes. See DDGI.md in the repository root.

config_version=5

[application]

config/name="DDGI Test"
config/description="Test scenes for ray traced dynamic diffuse global illumination (DDGI): an indoor room, an outdoor area and a stress test."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
rendering_device/driver.linux="vulkan"
