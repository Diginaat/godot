; Native indirect MultiMesh regression workload. See knowledge/PERFORMANCE_BENCHMARKS.md.
config_version=5

[application]
config/name="Native Large World Rendering Tests"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
